# Mongo connection string and database name
# Replace placeholders or configure via deployment secrets manager
MONGODB_URL=mongodb://appuser:dbuser123@localhost:5000/?authSource=admin
MONGODB_DB=myapp

# Optional Mongoose configuration
MONGODB_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=2
MONGODB_MAX_IDLE_TIME_MS=30000
NODE_ENV=development
